NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- Control plane database ----------
# Holds tenants, their database connection info, staff users and sessions.
CONTROL_DATABASE_URL=postgresql://treadcart:treadcart@localhost:5433/treadcart_control?schema=public

# ---------- Tenant databases ----------
# Each tenant gets its OWN database on this server.

TENANT_DB_ADMIN_URL=postgresql://treadcart:treadcart@localhost:5433/postgres
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5433
TENANT_DB_USER=treadcart
TENANT_DB_PASSWORD=treadcart
# Max tenant PrismaClients kept warm in the per-process registry (LRU).
TENANT_POOL_MAX_CLIENTS=25

# Idle ms before a tenant client is disconnected and evicted.
TENANT_POOL_IDLE_MS=300000

# ---------- Redis ----------
REDIS_URL=redis://localhost:6380
CACHE_TTL_SECONDS=300

# ---------- Auth opaque tokens ----------
AUTH_TOKEN_PEPPER=dev-only-change-me-0123456789abcdef0123456789abcdef
SESSION_TTL_SECONDS=86400

# HMAC key that signs checkout intents so the price cannot be tampered with.
CHECKOUT_SIGNING_SECRET=dev-only-change-me-checkout-secret

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- S3 / MinIO ----------
S3_REGION=us-east-1
S3_BUCKET=treadcart-media
S3_ACCESS_KEY_ID=treadcart
S3_SECRET_ACCESS_KEY=treadcart123
# Leave S3_ENDPOINT empty to talk to real Amazon S3.
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ---------- Google OAuth (seller "Continue with Google") ----------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/seller/auth/google/callback

SELLER_APP_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000

# ---------- Email (pick ONE) ----------
RESEND_API_KEY=

# Resend's sandbox sender works with no domain setup; change once you verify one.
MAIL_FROM=TreadCart <onboarding@resend.dev>

# ---------- SMS (Twilio) ----------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Google OAuth for customers ----------
GOOGLE_CUSTOMER_REDIRECT_URI=http://localhost:4000/v1/customer/auth/google/callback
